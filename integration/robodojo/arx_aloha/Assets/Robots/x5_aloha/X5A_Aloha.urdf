  <!--
    ALOHA/VX300 fingers and VT-Refine pads, mounted on the unchanged ARX
    wrist.  The 30 mm x-offset places the pad center at x=130 mm from link6,
    matching the useful inner-face center of the stock ARX gripper.  Keeping
    link6 as the controller TCP preserves the existing Cartesian action API.
  -->
  <link name="aloha_left_finger">
    <inertial>
      <origin xyz="0.135 0 0.0125" rpy="0 0 1.57" />
      <mass value="0.034796" />
      <inertia ixx="0.00002433" ixy="-0.0000024004" ixz="0" iyy="0.00001255" iyz="0" izz="0.00001417" />
    </inertial>
    <visual>
      <origin xyz="0.135 0 0.0125" rpy="0 0 1.57" />
      <geometry><mesh filename="meshes/aloha/gripper.obj" scale="0.001 0.001 0.001" /></geometry>
      <material name="aloha_black"><color rgba="0.05 0.05 0.05 1" /></material>
    </visual>
    <collision>
      <origin xyz="0.135 0 0.0125" rpy="0 0 1.57" />
      <geometry><mesh filename="meshes/aloha/gripper.obj" scale="0.001 0.001 0.001" /></geometry>
    </collision>
  </link>
  <joint name="joint7" type="prismatic">
    <origin xyz="0.030 0 0" rpy="0 0 0" />
    <parent link="link6" />
    <child link="aloha_left_finger" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="0.042" effort="100" velocity="1" />
    <dynamics friction="0.1" />
  </joint>

  <link name="aloha_left_pad">
    <inertial>
      <mass value="0.002" />
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001" />
