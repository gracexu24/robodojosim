  </link>
  <joint name="aloha_left_pad_joint" type="fixed">
    <origin xyz="0.10 0.0012 0" rpy="0 -1.57079632679 0" />
    <parent link="aloha_left_finger" />
    <child link="aloha_left_pad" />
  </joint>

  <link name="aloha_right_finger">
    <inertial>
      <origin xyz="0.135 0 -0.0125" rpy="3.14 0 -1.57" />
      <mass value="0.034796" />
      <inertia ixx="0.00002433" ixy="0.0000024001" ixz="0" iyy="0.00001255" iyz="0" izz="0.00001417" />
    </inertial>
