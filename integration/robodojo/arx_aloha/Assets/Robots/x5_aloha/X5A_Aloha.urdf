      <geometry><mesh filename="meshes/aloha/gripper.obj" scale="0.001 0.001 0.001" /></geometry>
    </collision>
  </link>
  <joint name="joint8" type="prismatic">
    <origin xyz="0.030 0 0" rpy="0 0 0" />
    <parent link="link6" />
    <child link="aloha_right_finger" />
    <!-- Reverse the right-finger axis so both joints use a positive opening
         coordinate. Physical motion is unchanged, while RoboDojo's generic
         gripper-open evaluator can average the two joint values correctly. -->
    <axis xyz="0 -1 0" />
    <limit lower="0" upper="0.042" effort="100" velocity="1" />
    <dynamics friction="0.1" />
  </joint>

  <link name="aloha_right_pad">
